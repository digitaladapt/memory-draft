# Test environment. Committed on purpose (GUIDING-LIGHT §5.1) — no real values.

APP_ENV=test
APP_DEBUG=1
APP_SECRET=test-secret-not-a-real-secret

# `config/packages/routing.yaml` requires this with no fallback, and it is only
# needed to generate URLs outside an HTTP request (CLI, Messenger). CI's env
# strategy is "copy this file to .env", so if it is missing here the app cannot
# boot there at all — `cache:clear` dies with "Environment variable not found:
# DEFAULT_URI" before a single test runs. The value is semantically inert for
# the suite, but the variable has to exist.
DEFAULT_URI=http://localhost

# In-memory store: every test starts from nothing, and nothing is left behind.
MEMORY_DB_PATH=:memory:
MEMORY_HOT_CAP=20
MEMORY_COLD_CAP=200
