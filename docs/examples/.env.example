# MemoryDraft — environment variables
#
# Copy to .env for local development, or pass these into the container.
# .env itself is never committed (.dockerignore excludes it) because a committed
# environment file is how secrets end up in an image layer.

# ── Server ────────────────────────────────────────────────────────────────────
APP_ENV=prod
APP_DEBUG=0

# Generate a fresh value per deployment:
#   php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
# Deliberately left empty here — a default secret in a committed file is worse
# than no default, because it is the value every deployment would silently share.
APP_SECRET=

# ── Memory store ──────────────────────────────────────────────────────────────
# Where the memory store lives. A single SQLite file, so a backup is a file
# copy. In Docker this is the mounted volume path, which is what makes memory
# survive a container rebuild.
MEMORY_DB_PATH=/data/memory.db

# How many unpinned sentences a single key keeps in the hot tier — the tier
# recall shows by default — before the oldest are demoted to cold storage.
#
# This is the number that protects a context window, and it is per key rather
# than global: what actually threatens the window is how many sentences one key
# returns, not how many exist overall.
MEMORY_HOT_CAP=20

# How many unpinned sentences a single key keeps in cold storage before the
# oldest are deleted outright.
#
# This is the ONLY place memory is ever destroyed. Size it for how much history
# you want to be able to recover, not for how much you expect to use day to day.
MEMORY_COLD_CAP=200

# ── Timezone ──────────────────────────────────────────────────────────────────
# Affects the wall-clock labels in logs only; all stored timestamps are UTC.
TZ=UTC
